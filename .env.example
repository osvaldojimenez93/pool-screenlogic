# Pool ScreenLogic - Environment Configuration
# Copy to .env and adjust values as needed.

# Gateway connection (omit to use UDP auto-discovery)
# SCREENLOGIC_HOST=192.168.1.50
# SCREENLOGIC_PORT=80
# SCREENLOGIC_NAME="Pentair: 00-00-00"
# SCREENLOGIC_PASSWORD=

# Discovery timeout in milliseconds
# SCREENLOGIC_SEARCH_MS=2500

# HTTP server
# PORT=3000
# HOST=127.0.0.1
